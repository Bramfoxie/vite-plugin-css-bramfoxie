{
  "name": "vite-plugin-css-bramfoxie",
  "private": false,
  "version": "3.0.0",
  "description": "Vite plugin to minify CSS",
  "author": "Milana Kustinskaya <account@bramfoxie.com>",
  "license": "MIT",
  "homepage": "https://github.com/Bramfoxie/vite-plugin-css-bramfoxie",
  "type": "module",
  "keywords": [
    "vite",
    "vite-plugin",
    "css",
    "compiler"
  ],
  "files": [
    "dist",
    "index.d.ts"
  ],
  "types": "./index.d.ts",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./dist/css-bramfoxie.umd.js",
  "module": "./dist/css-bramfoxie.es.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/css-bramfoxie.es.js",
      "require": "./dist/css-bramfoxie.umd.js"
    }
  },
  "scripts": {
    "dev": "vite build --config dev.vite.config.js",
    "build": "vite build --config build.vite.config.js"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "vite": ">=8"
  },
  "dependencies": {
    "clean-css": "^5.3.3",
    "picocolors": "^1.1.1"
  }
}
